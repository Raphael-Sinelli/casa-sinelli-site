# Cloudinary (CDN de imagens do catálogo)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Caminho local do catálogo de imagens (fallback quando a imagem não está
# no mapa Cloudinary — usado por src/app/api/catalogo/[...slug]/route.ts).
# Opcional em produção; necessário só em dev se você quiser o fallback ativo.
CATALOGO_LOCAL_PATH=
